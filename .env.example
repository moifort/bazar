NITRO_ADMIN_TOKEN=
NITRO_GOOGLE_API_KEY=
# Optional: a non-URL value (empty, "-") disables error reporting
NITRO_SENTRY_DSN=
# Comma-separated Firebase uids granted Premium outright, on top of the App Store entitlement
NITRO_PREMIUM_USER_IDS=
# The app's numeric App Store id — needed to verify a Production StoreKit signature
NITRO_APPLE_APP_ID=
# Pins StoreKit signature checks to one environment; "Xcode" for the local .storekit file
NITRO_APPLE_ENVIRONMENT=
